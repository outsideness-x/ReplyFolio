APP_URL=https://YOUR_APP_DOMAIN
META_APP_ID=
META_APP_SECRET=
# Meta app secret for the webhook signature. It may differ from the Instagram OAuth secret.
META_WEBHOOK_SECRET=
META_GRAPH_VERSION=v26.0
META_VERIFY_TOKEN=
# Generate independently: openssl rand -hex 32
WORKER_SECRET=
# Exactly 32 random bytes, encoded as base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Independent 32-byte AES key for server-held login tokens.
SESSION_ENCRYPTION_KEY=
# Same independent 32-byte random hex value in Cloudflare Pages and Edge secrets.
GATEWAY_SECRET=
# Independent secret for hashed rate-limit keys and device signatures.
RATE_LIMIT_SECRET=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
EMAIL_FROM=
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by the Edge runtime.
